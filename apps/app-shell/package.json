{
  "name": "qushuiyin-desktop-client",
  "version": "1.1.7",
  "private": true,
  "main": "electron/main.cjs",
  "description": "去水印解析电脑版客户端",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons:generate": "node ../../scripts/generate_app_icons.cjs --desktop",
    "build": "npm run icons:generate && vite build --base=./",
    "desktop": "npm run build && electron electron/main.cjs",
    "desktop:dev": "electron electron/main.cjs",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.yuchen.qushuiyin",
    "productName": "去水印解析",
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "yuchen0x1",
        "repo": "Short-Video-Analysis"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US",
      "en-GB"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../CHANGELOG.md",
        "to": "changelog/CHANGELOG.md"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${name}-setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
